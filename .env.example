# ============================================
# AI-POWERED TODO & WORKFLOW MANAGEMENT SYSTEM
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------- Database (Neon PostgreSQL) ----------
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Synchronous URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------- Authentication ----------
SECRET_KEY=your-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- Password Policy ----------
DEFAULT_PASSWORD_EXPIRY_DAYS=30
MIN_PASSWORD_LENGTH=8

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ---------- Application ----------
APP_NAME=AI-Powered Todo & Workflow Management
APP_VERSION=1.0.0
DEBUG=false

# ---------- Seed Data ----------
# Temporary admin password for initial setup (change immediately)
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
